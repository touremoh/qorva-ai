{
  "collMod": "stripe_product_references",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "stripe_product_references",
      "required": ["stripeProductId", "name", "active", "createdAt", "lastUpdatedAt", "createdBy", "lastUpdatedBy"],
      "properties": {
        "stripeProductId": {
          "bsonType": "string",
          "description": "Stripe product ID — unique identifier from Stripe"
        },
        "name": {
          "bsonType": "string",
          "description": "Product name as defined in Stripe"
        },
        "description": {
          "bsonType": "string"
        },
        "active": {
          "bsonType": "bool",
          "description": "Whether the product is currently active in Stripe"
        },
        "metadata": {
          "bsonType": "object",
          "description": "Key-value metadata copied from Stripe"
        },
        "prices": {
          "bsonType": "array",
          "description": "All prices associated with this product",
          "items": {
            "bsonType": "object",
            "required": ["stripePriceId", "currency", "active"],
            "properties": {
              "stripePriceId": {
                "bsonType": "string",
                "description": "Stripe price ID"
              },
              "currency": {
                "bsonType": "string",
                "description": "ISO 4217 currency code, e.g. usd"
              },
              "interval": {
                "bsonType": ["string", "null"],
                "description": "Billing interval: month, year, week, day; null for one-time"
              },
              "intervalCount": {
                "bsonType": ["int", "null"],
                "description": "Number of intervals between billings"
              },
              "unitAmount": {
                "bsonType": ["long", "null"],
                "description": "Price in the smallest currency unit (cents)"
              },
              "nickname": {
                "bsonType": ["string", "null"]
              },
              "active": {
                "bsonType": "bool"
              }
            }
          }
        },
        "features": {
          "bsonType": "object",
          "description": "Plan feature configuration including seat count, usage limits, and overage pricing",
          "properties": {
            "seats": {
              "bsonType": ["int", "null"],
              "description": "Number of seats included in the plan"
            },
            "limits": {
              "bsonType": "object",
              "properties": {
                "screeningActions": {
                  "bsonType": ["int", "null"]
                },
                "aiResumeChats": {
                  "bsonType": ["int", "null"]
                },
                "talentIntelligenceQueries": {
                  "bsonType": ["int", "null"]
                }
              }
            },
            "overage": {
              "bsonType": "object",
              "properties": {
                "enabled": {
                  "bsonType": "bool"
                },
                "screeningActionPrice": {
                  "bsonType": ["double", "null"]
                },
                "chatPrice": {
                  "bsonType": ["double", "null"]
                },
                "intelligenceQueryPrice": {
                  "bsonType": ["double", "null"]
                }
              }
            }
          }
        },
        "createdAt": {
          "bsonType": "date"
        },
        "lastUpdatedAt": {
          "bsonType": "date"
        },
        "createdBy": {
          "bsonType": "string"
        },
        "lastUpdatedBy": {
          "bsonType": "string"
        }
      }
    }
  },
  "validationAction": "error",
  "validationLevel": "strict"
}
